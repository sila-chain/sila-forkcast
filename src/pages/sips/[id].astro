---
import Layout from '../../layouts/Layout.astro';
import { EipPage } from '../../components/sip';
import { eipsData } from '../../data/sips';
import { getLaymanTitle, getProposalPrefix } from '../../utils/sip';

export function getStaticPaths() {
  return eipsData
    .map((sip) => {
      const label = `${getProposalPrefix(sip)}-${sip.id}`;
      return {
        params: { id: String(sip.id) },
        props: {
          title: `${label}: ${getLaymanTitle(sip)} - SilaForkcast`,
          description: `Description, timeline, and status of ${label}: ${getLaymanTitle(sip)}`,
        },
      };
    });
}

const id = Astro.params.id!;
const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <EipPage client:only="react" id={id} />
</Layout>
